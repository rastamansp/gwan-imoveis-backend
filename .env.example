# Configurações básicas
NODE_ENV=development
PORT=3009

# API Base URL para QR Codes
API_BASE_URL=http://localhost:3009

# JWT Secret (em produção, use uma chave segura)
JWT_SECRET=your-secret-key-change-in-production

# MCP Server
MCP_BASE_URL=http://localhost:3009
MCP_PORT_SSE=3002
MCP_AUTH_TOKEN=your-auth-token

# CORS para frontend
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:3009,http://127.0.0.1:5173

# Conexão com o banco de dados
DATABASE_URL=postgresql://postgres:password@localhost:5432/gwan_imoveis

# Chat AI (OpenAI ou Claude)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4o-mini
CLAUDE_API_KEY=your-claude-api-key
CLAUDE_MODEL=claude-haiku-4-5
CLAUDE_FALLBACK_MODELS=claude-haiku-4-5-20251001,claude-sonnet-4-6

# Embeddings (RAG de imóveis) — provider configurável
# voyage = recomendação Anthropic (Voyage AI), default
# openai = fallback alternativo
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=pa-your-voyage-api-key-here
VOYAGE_EMBEDDING_MODEL=voyage-3-lite
VOYAGE_API_BASE_URL=https://api.voyageai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Evolution API (WhatsApp)
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE=your-evolution-instance
EVOLUTION_INSTANCE_URL=http://localhost:8080
EVOLUTION_INSTANCE_NAME=Gwan
# Quando setada, novas instâncias criadas em POST /api/users/me/whatsapp/instance
# já vêm com este webhook registrado (subscreve apenas MESSAGES_UPSERT em base64).
# Em produção: https://imoveis-api.gwan.cloud/api/webhooks/whatsapp
EVOLUTION_WHATSAPP_WEBHOOK_URL=

# Redis Cache
REDIS_URL=redis://localhost:6379

# MinIO (Storage de Imagens)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=gwan-imoveis-uploads
MINIO_USE_SSL=false
# MINIO_PUBLIC_URL: URL pública para gerar links de imagens (em produção: https://minio.gwan.cloud)
# Se não definido, usa http(s)://MINIO_ENDPOINT:MINIO_PORT
MINIO_PUBLIC_URL=