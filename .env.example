# Configurações básicas
NODE_ENV=development
PORT=3009

FRONTEND_URL=https://imoveis.gwan.cloud/

# API Base URL para QR Codes
API_BASE_URL=http://localhost:3009

# JWT Secret (em produção, use uma chave segura)
JWT_SECRET=your-secret-key-change-in-production

# MCP Server
MCP_BASE_URL=http://localhost:3009
MCP_PORT_SSE=3002
MCP_AUTH_TOKEN=your-auth-token

# CORS para frontend
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:3009,http://127.0.0.1:5173

# Conexão com o banco de dados
DATABASE_URL=postgresql://postgres:password@localhost:5432/gwan_imoveis

# Chat AI (OpenAI ou Claude)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4o-mini
CLAUDE_API_KEY=your-claude-api-key
CLAUDE_MODEL=claude-haiku-4-5
CLAUDE_FALLBACK_MODELS=claude-haiku-4-5-20251001,claude-sonnet-4-6

# Embeddings (RAG de imóveis) — provider configurável
# voyage = recomendação Anthropic (Voyage AI), default
# openai = fallback alternativo
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=pa-your-voyage-api-key-here
VOYAGE_EMBEDDING_MODEL=voyage-3-lite
VOYAGE_API_BASE_URL=https://api.voyageai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Evolution API (WhatsApp)
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE=your-evolution-instance
EVOLUTION_INSTANCE_URL=http://localhost:8080
EVOLUTION_INSTANCE_NAME=Gwan
# Quando setada, novas instâncias criadas em POST /api/users/me/whatsapp/instance
# já vêm com este webhook registrado (subscreve apenas MESSAGES_UPSERT em base64).
# Em produção: https://imoveis-api.gwan.cloud/api/webhooks/whatsapp
EVOLUTION_WHATSAPP_WEBHOOK_URL=

# Token compartilhado para autenticar requisições POST em /api/webhooks/whatsapp.
# Quando vazio, a checagem é desabilitada (apenas dev local). Em produção é obrigatório:
# o Evolution deve ser configurado para enviar o header X-Evolution-Token com o mesmo valor.
WHATSAPP_WEBHOOK_SECRET=

# Feature flags
# Quando false, o cadastro de novos usuários via WhatsApp fica desativado: usuários
# não cadastrados que enviarem mensagem recebem orientação para se cadastrar pelo site.
FEATURE_WHATSAPP_REGISTRATION=false

# Redis Cache
REDIS_URL=redis://localhost:6379

# MinIO (Storage de Imagens)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=gwan-imoveis-uploads
MINIO_USE_SSL=false
# MINIO_PUBLIC_URL: URL pública para gerar links de imagens (em produção: https://minio.gwan.cloud)
# Se não definido, usa http(s)://MINIO_ENDPOINT:MINIO_PORT
MINIO_PUBLIC_URL=

# ==========================================
# Rate limiting (duas janelas: 1 minuto e 24 horas)
# ==========================================
# Os defaults nascem FOLGADOS de proposito: limite apertado demais bloqueia
# usuario legitimo, e esse custo e maior que o de uma janela a mais de abuso.
# Aperte depois, com base em metrica real. Deixar em branco usa o default.
#
# Leitura publica do catalogo (precisa caber navegacao com filtros e paginacao)
THROTTLE_PUBLIC_PER_MINUTE=120
THROTTLE_PUBLIC_PER_DAY=10000
# Endpoints que fazem chamada PAGA a provedor de IA (/properties/extract, /chat).
# A janela diaria e o que pega o loop lento, que passa por baixo do limite por minuto.
THROTTLE_AI_PER_MINUTE=10
THROTTLE_AI_PER_DAY=200
# Autenticacao: defesa contra forca bruta, nao contra custo.
THROTTLE_AUTH_PER_MINUTE=10
THROTTLE_AUTH_PER_DAY=100
#
# ATENCAO — rodando a suite BDD (npm run test:bdd):
# A suite dispara 343 steps contra o mesmo IP em menos de um minuto, o que estoura
# os limites acima e faz TODOS os cenarios falharem com uma mensagem enganosa
# ("API nao esta disponivel" — na verdade e 429). Suba a API local/CI com os valores
# abaixo. Eles valem SO para teste e nao devem ir para producao.
#
#   THROTTLE_PUBLIC_PER_MINUTE=100000
#   THROTTLE_PUBLIC_PER_DAY=1000000
#   THROTTLE_AUTH_PER_MINUTE=1000
#   THROTTLE_AUTH_PER_DAY=100000
#   THROTTLE_AI_PER_MINUTE=1000
#   THROTTLE_AI_PER_DAY=100000

# ==========================================
# Transcricao de audio do WhatsApp (F18) — gwan-stt
# ==========================================
# Consumo INTERNO na gwan-network: nao passa pelo Traefik, nao usa DNS publico.
# Sem STT_URL a feature fica desligada e o audio volta a ser registrado como
# "[Audio]" — nada quebra.
STT_URL=http://gwan-stt:8000
# Em dev local, com o gwan-stt rodando na porta 3063:
# STT_URL=http://localhost:3063

STT_TIMEOUT_MS=300000          # transcricao pode demorar; nao ha fallback, esperar e a opcao
STT_HEALTH_TIMEOUT_MS=5000     # a pergunta "ha worker?" tem de ser barata
STT_MAX_AUDIO_MB=25            # acima disso o job nasce falho, sem gravar bytes
STT_PENDING_TTL_HOURS=6        # depois disso pedimos o texto em vez de responder fora de contexto
STT_MAX_ATTEMPTS=60
STT_RETRY_BACKOFF_SECONDS=120
STT_RECONCILER_INTERVAL_MS=60000
STT_RECONCILER_BATCH=5
STT_ACK_ENABLED=true           # confirma o recebimento quando o audio entra na fila

# Cache do embedding de CONSULTA (busca semantica) no Redis.
# So a consulta e cacheada: embedding de imovel ja e persistido no PostgreSQL.
# A chave inclui provider e modelo — trocar de provider nao reaproveita vetor de
# dimensao diferente. Falha do Redis nunca quebra a busca.
EMBEDDING_CACHE_TTL_SECONDS=3600
